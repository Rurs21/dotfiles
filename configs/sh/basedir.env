# fix shit non XDG Base directory compliant

# zsh
export ZDOTDIR=$CONFIG_HOME/zsh

# less
export LESSHISTFILE=$STATE_HOME/lesshst

# cargo
export CARGO_HOME=$CACHE_HOME/cargo
export CARGO_CONFIG_GLOBAL=$CONFIG_HOME/cargo/config.toml

# npm
export NPM_CONFIG_USERCONFIG=$CONFIG_HOME/npm/npmrc

# rg
export RIPGREP_CONFIG_PATH=$CONFIG_HOME/ripgrep/config

# claude
export CLAUDE_CONFIG_DIR=$CONFIG_HOME/claude

# gnupg
export GNUPGHOME=$DATA_HOME/gnupg

